<Project>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <Deterministic>true</Deterministic>
    <Version>1.2.8</Version>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'LanChat.Domain'">
    <Compile Include="$(MSBuildThisFileDirectory)src/LanChat.Domain/IsExternalInit.cs" Link="IsExternalInit.cs" />
  </ItemGroup>
</Project>
