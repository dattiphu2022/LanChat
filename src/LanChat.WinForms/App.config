<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- Tối ưu GC cho .NET Framework - giới hạn bộ nhớ để tránh RAM cao -->
    <gc generation="0" maxSizePercent="35" />
    <gc generation="1" maxSizePercent="40" />
    <gc generation="2" maxSizePercent="65" />
  </runtime>

  <!-- Tối ưu cho Windows Forms -->
  <system.windows.forms>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </system.windows.forms>
</configuration>