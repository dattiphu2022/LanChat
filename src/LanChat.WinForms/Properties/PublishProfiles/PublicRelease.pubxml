<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net48</TargetFramework>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <LanChatPublicRelease>true</LanChatPublicRelease>
    <DefineConstants>$(DefineConstants);LANCHAT_PUBLIC_RELEASE</DefineConstants>
    <IntermediateOutputPath>obj/public-release/$(Configuration)/</IntermediateOutputPath>
    <OutputPath>bin/public-release/$(Configuration)/</OutputPath>
    <LanChatPublicArtifactsDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '../../artifacts/public-release'))</LanChatPublicArtifactsDir>
    <PublishDir>$(LanChatPublicArtifactsDir)publish/</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
    <LanChatReleaseVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../LanChat.Application/Contracts.cs')), 'const\s+string\s+CurrentApplicationVersion\s*=\s*&quot;([0-9]+\.[0-9]+\.[0-9]+)&quot;;').Groups[1].Value)</LanChatReleaseVersion>
    <Version Condition="'$(LanChatReleaseVersion)' != ''">$(LanChatReleaseVersion)</Version>
  </PropertyGroup>
  <Import Project="$(MSBuildProjectDirectory)/../../installer/PublicInstaller.targets" />
</Project>
