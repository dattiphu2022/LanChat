<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets/LanChat.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LanChatPublicRelease)' == 'true'">
    <DefineConstants>$(DefineConstants);LANCHAT_PUBLIC_RELEASE</DefineConstants>
    <IntermediateOutputPath Condition="'$(LanChatPublicBuildDirectory)' != ''">$(LanChatPublicBuildDirectory)/obj/</IntermediateOutputPath>
    <OutputPath Condition="'$(LanChatPublicBuildDirectory)' != ''">$(LanChatPublicBuildDirectory)/bin/</OutputPath>
  </PropertyGroup>
  <!-- Tối ưu bộ nhớ: giới hạn cache thumbnail và GC -->
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <ProjectReference Include="../LanChat.Infrastructure/LanChat.Infrastructure.csproj" />
    <ProjectReference Include="../../tools/LanChat.Signing/LanChat.Signing.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <InternalsVisibleTo Include="LanChat.Tests" />
    <EmbeddedResource Include="Assets/DonationQr.png" LogicalName="LanChat.DonationQr" />
    <EmbeddedResource Include="Assets/Suggestions/*.gif" LogicalName="LanChat.Suggestions.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../docs/HUONG_DAN_SU_DUNG.md" LogicalName="LanChat.UserGuide" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="LanChat.License" />
    <Content Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../CodeSigning.local.props" Condition="Exists('../../CodeSigning.local.props')" />
  <Target Name="SignDevelopmentBuild" AfterTargets="Build" Condition="'$(LanChatDevelopmentSigning)' == 'true'">
    <Exec Command="&quot;$(MSBuildProjectDirectory)/../../tools/LanChat.Signing/bin/$(Configuration)/net48/LanChat.Signing.exe&quot; sign --thumbprint &quot;$(LanChatSigningThumbprint)&quot; &quot;$(TargetPath)&quot;" />
  </Target>
  <Target Name="SignDevelopmentPublish" AfterTargets="Publish" BeforeTargets="BuildInnoSetup" Condition="'$(LanChatDevelopmentSigning)' == 'true'">
    <Exec Command="&quot;$(MSBuildProjectDirectory)/../../tools/LanChat.Signing/bin/$(Configuration)/net48/LanChat.Signing.exe&quot; sign --thumbprint &quot;$(LanChatSigningThumbprint)&quot; &quot;$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PublishDir)'))/$(TargetFileName)&quot;" />
  </Target>
  <ItemGroup Condition="'$(LanChatPublicRelease)' != 'true' and Exists('Assets/DefaultNetwork.local.json')">
    <EmbeddedResource Include="Assets/DefaultNetwork.local.json" LogicalName="LanChat.DefaultNetwork" />
  </ItemGroup>
  <Target Name="BuildInnoSetup" AfterTargets="Publish" Condition="'$(BuildInstaller)' != 'false' and '$(LanChatPublicRelease)' != 'true'">
    <PropertyGroup>
      <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == '' and Exists('$(MSBuildProgramFiles32)/Inno Setup 6/ISCC.exe')">$(MSBuildProgramFiles32)/Inno Setup 6/ISCC.exe</InnoSetupCompiler>
      <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == '' and Exists('$(LocalAppData)/Programs/Inno Setup 6/ISCC.exe')">$(LocalAppData)/Programs/Inno Setup 6/ISCC.exe</InnoSetupCompiler>
      <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == ''">ISCC.exe</InnoSetupCompiler>
      <InstallerScript>$(MSBuildProjectDirectory)/../../installer/LanChat.iss</InstallerScript>
      <InstallerPublishDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PublishDir)'))</InstallerPublishDir>
      <DevelopmentSignArguments Condition="'$(LanChatDevelopmentSigning)' == 'true'">&quot;/DLanChatDevelopmentSigning&quot; &quot;/SLanChatDevelopment=$q$(MSBuildProjectDirectory)/../../tools/LanChat.Signing/bin/$(Configuration)/net48/LanChat.Signing.exe$q sign --thumbprint $(LanChatSigningThumbprint) $f&quot;</DevelopmentSignArguments>
    </PropertyGroup>
    <Error Condition="!Exists('Assets/DefaultNetwork.local.json')" Text="Missing the shared default invitation. Restore Assets/DefaultNetwork.local.json from the internal release backup before publishing the installer." />
    <Error Condition="!Exists('$(InstallerPublishDir)/$(TargetFileName)')" Text="WinForms publish output is missing from $(InstallerPublishDir)." />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/../../installer/PublishDir.local.iss"
                      Lines="#define PublishDir &quot;$([MSBuild]::EnsureTrailingSlash('$(InstallerPublishDir)')).&quot;"
                      Overwrite="true" Encoding="UTF-8" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="&quot;$(InnoSetupCompiler)&quot; &quot;/DPublishDir=$([MSBuild]::EnsureTrailingSlash('$(InstallerPublishDir)')).&quot; $(DevelopmentSignArguments) &quot;$(InstallerScript)&quot;" />
  </Target>
</Project>
